{
  "compilerOptions": {
    /* Target modern browsers */
    "target": "ES2021",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    /* Allow JavaScript files */
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    /* Module system and resolution */
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    /* For JSON and isolated files */
    "resolveJsonModule": true,
    "isolatedModules": true,
    /* 👇 Fix JSX namespace issue here */
    "jsx": "preserve",
    "types": [
      "node",
      "react",
      "react-dom"
    ],
    /* Improve build speed */
    "incremental": true,
    /* 👇 Base URL + Path Aliases */
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./*"
      ],
      "@/app/*": [
        "./app/*"
      ],
      "@/components/*": [
        "./components/*"
      ],
      "@/hooks/*": [
        "./hooks/*"
      ],
      "@/lib/*": [
        "./lib/*"
      ],
      "@/utils/*": [
        "./utils/*"
      ],
      "@/public/*": [
        "./public/*"
      ]
    },
    /* Enable Next.js plugin */
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "next-env.d.ts",
    ".next/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next"
  ]
}
